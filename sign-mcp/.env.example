# CloseOS Sign MCP — configuration (copie ce fichier en .env)

# Projet Supabase CloseOS
SUPABASE_URL=https://qwjvdwpixewsctircibl.supabase.co

# Clé service-role (Supabase → Project Settings → API → service_role secret).
# NE JAMAIS committer cette clé. Elle contourne la RLS : garde-la privée.
SUPABASE_SERVICE_ROLE_KEY=

# Propriétaire Sign pour lequel les contrats sont créés (doit exister dans sign_users).
SIGN_OWNER_EMAIL=

# (optionnel) Base URL de l'app Sign, pour les liens d'éditeur retournés.
SIGN_APP_URL=https://sign.closeos.fr
